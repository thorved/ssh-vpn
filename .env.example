# SSH listener
SSH_PORT=2222
SSH_LISTEN_ADDR=:2222
SSH_HOST_KEY_PATH=backend/data/host_key
SSH_SERVER_IDENT=SSH-2.0-ssh-vpn

# Public values shown in dashboard-generated SSH commands
PUBLIC_DOMAIN=localhost
PUBLIC_SSH_PORT=2222

# Admin dashboard over SSH local forwarding
ADMIN_USER=root
ADMIN_DASHBOARD_PORT=8080
ADMIN_AUTHORIZED_KEYS_FILE=backend/admin_authorized_keys.example

# Static Next export served by Go
WEB_STATIC_DIR=frontend/out
